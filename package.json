{
  "name": "@ligule/workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "pnpm exec tsc -b tsconfig.json",
    "build:core": "pnpm --filter @ligule/core run build",
    "build:tui": "pnpm --filter ligule run build",
    "test:core": "pnpm --filter @ligule/core run test",
    "test:tui": "pnpm --filter ligule run test",
    "test:integration": "node --experimental-strip-types --test --test-reporter=./scripts/test-summary-reporter.mjs --test-concurrency=1 --import ./tests/hooks/isolated-data-root.ts tests/*.test.js tests/*.test.ts",
    "test:engineering": "node scripts/test-summary-reporter-check.mjs && node --experimental-strip-types --test --test-reporter=./scripts/test-summary-reporter.mjs .github/engineering/tests/*.test.mjs .github/engineering/tests/*.test.ts",
    "test": "pnpm run build && pnpm run test:core && pnpm run test:tui && pnpm run test:integration && pnpm run test:engineering",
    "eval:smoke": "node scripts/eval-smoke.mjs",
    "check-pack": "pnpm --filter ligule run check-pack",
    "verify-install": "pnpm --filter ligule run verify-install",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:syntax": "node scripts/check-js-syntax.ts",
    "prepare-runtime": "pnpm --filter ligule-desktop run prepare-runtime",
    "registry-version": "node scripts/registry-version.js"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "cross-spawn": "7.0.6",
    "dependency-cruiser": "18.7.0",
    "typescript": "^5.9.3"
  }
}
