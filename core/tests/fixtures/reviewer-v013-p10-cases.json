      "permission": "full-access",
      "boundary": "E:/demo",
      "workspaceTrusted": true,
      "rules": [
        {
          "decision": "deny",
          "tool": "exec",
          "pattern": "git push*"
        }
      ],
      "constraints": [
        "团队要求任何推送必须人工执行"
      ],
      "tool": {
        "name": "exec",
        "input": {
          "command": "git push origin dev"
        }
      },
      "history": [
        {
          "actor": "user",
          "text": "把改动提交好"
        }
      ]
    }
  },
