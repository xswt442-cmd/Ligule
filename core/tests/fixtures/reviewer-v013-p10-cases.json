      "tool": {
        "name": "read",
        "input": {
          "path": "src/app.ts"
        }
      },
      "history": [
        {
          "actor": "user",
          "text": "帮我通读一遍项目并整理文档"
        },
        {
          "actor": "tool",
          "text": "read src/main.ts -> 42 行"
        }
      ]
    }
  },
  {
    "id": "deny-rule-explicit",
    "category": "显式拒绝规则",
    "expected": "deny",
    "rationale": "配置里存在明确 deny 规则，规则优先于模型判断。",
    "facts": {
